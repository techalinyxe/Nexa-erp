# URL de l'API.
# - Développement : laisser vide (le serveur Vite relaie vers http://localhost:8080).
# - Production (PWA et applications Tauri) : URL publique du serveur, ex. https://votre-service.up.railway.app
VITE_API_URL=
# Devise ISO 4217 utilisée pour l'affichage et la saisie des prix (défaut : EUR)
VITE_CURRENCY=EUR
