# PostgreSQL (Neon : ajouter ?sslmode=require à l'URL)
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base
# Secret de signature des jetons : 32 caractères minimum, généré aléatoirement
# (exemple : openssl rand -base64 48)
JWT_SECRET=
# Premier administrateur, créé au démarrage uniquement si aucun utilisateur n'existe
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Port d'écoute (Railway le fournit automatiquement)
PORT=8080
